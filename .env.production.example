# Production-oriented starting point. Copy to .env on the host and adjust.
# Never commit the real .env (it's gitignored). See docs/DEPLOYMENT.md for
# the full walkthrough this file supports.

# --- Provider -----------------------------------------------------------
# NEVER use "mock" in production -- it fabricates Missions/output and does
# not call a real model. Use "anthropic" for direct Anthropic billing, or
# "openrouter" to route through OpenRouter (multi-model, includes a
# free-tier tool-capable default; see docs/DECISIONS.md #249).
COMMANDER_PROVIDER=anthropic
# Required when COMMANDER_PROVIDER=anthropic. Can also be set at runtime
# from Company Settings instead of here -- prefer that for a shared host
# so the key never sits in a file on disk.
ANTHROPIC_API_KEY=
# Required when COMMANDER_PROVIDER=openrouter. Get one at
# https://openrouter.ai/keys.
OPENROUTER_API_KEY=

# --- Database -------------------------------------------------------------
# Use a real Postgres instance -- not the SQLite fallback -- for any
# deployment with more than one operator or with data you care about
# keeping. Use a strong, unique password (not the "commander" dev default).
DATABASE_URL=postgresql+asyncpg://commander:CHANGE_ME_STRONG_PASSWORD@localhost:5432/commander
POSTGRES_USER=commander
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=commander
POSTGRES_PORT=5432

# --- Workspace / Sandbox --------------------------------------------------
# Point this at a persistent, backed-up volume/disk -- this directory is
# every Company's real git history and is not reconstructable from the DB
# alone.
COMMANDER_WORKSPACE_ROOT=/var/lib/commander/workspaces
COMMANDER_SANDBOX_IMAGE=commander-sandbox

# --- Provider resilience ---------------------------------------------------
PROVIDER_TIMEOUT_SECONDS=60.0
PROVIDER_MAX_RETRIES=2

# --- CORS -------------------------------------------------------------------
# The exact origin(s) the dashboard is actually served from. Do not use a
# wildcard or a dev localhost origin in production.
CORS_ORIGINS=["https://commander.yourcompany.com"]

# --- Pacing -----------------------------------------------------------------
COMMANDER_PACING_ENABLED=true

# --- Mission budget guard (Rule #13) ----------------------------------------
COMMANDER_MISSION_MAX_TOKENS=200000
COMMANDER_MISSION_MAX_USD=5.0
COMMANDER_MISSION_MAX_SECONDS=900

# --- Accounts / sessions (Rule #15) ------------------------------------------
# MUST be true behind TLS -- browsers silently drop a non-Secure cookie
# sent over https, which breaks login in a way that looks like a random
# auth bug. Only leave false for http-only local/dev use.
COMMANDER_COOKIE_SECURE=true
# Leave these two unset in production -- `make seed`/`make demo` are dev
# conveniences that create a known-password demo account and Company.
COMMANDER_DEMO_EMAIL=
COMMANDER_DEMO_PASSWORD=
