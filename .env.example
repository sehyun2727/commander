# Copy to .env and adjust. Never commit the real .env (it's gitignored).

# --- Provider -----------------------------------------------------------
# "mock" needs zero API keys and is always safe to run. "anthropic" makes
# real calls billed to your Anthropic account.
COMMANDER_PROVIDER=mock
# Only required when COMMANDER_PROVIDER=anthropic. Can also be set at
# runtime from Company Settings instead of here.
ANTHROPIC_API_KEY=

# --- Database -------------------------------------------------------------
# Default: the docker-compose Postgres service (`make db-up`). Must match
# the POSTGRES_* creds below.
DATABASE_URL=postgresql+asyncpg://commander:commander@localhost:5432/commander
# Fallback for zero-dependency local runs / CI without Docker:
# DATABASE_URL=sqlite+aiosqlite:///./commander.db

# Credentials for the docker-compose postgres service (Phase 1). Only
# used by `docker compose up postgres`; change them for anything beyond
# local dev.
POSTGRES_USER=commander
POSTGRES_PASSWORD=commander
POSTGRES_DB=commander
POSTGRES_PORT=5432

# --- Workspace / Sandbox --------------------------------------------------
# Where each company's git-backed workspace lives on disk.
COMMANDER_WORKSPACE_ROOT=./workspaces
# Docker image built by `make sandbox-image`, used to run trusted
# template CheckSpecs (Sprint 6). Only needed if you want sandboxed
# checks; the product degrades gracefully without it.
COMMANDER_SANDBOX_IMAGE=commander-sandbox

# --- Provider resilience ---------------------------------------------------
PROVIDER_TIMEOUT_SECONDS=60.0
PROVIDER_MAX_RETRIES=2

# --- CORS -------------------------------------------------------------------
# JSON array of allowed dashboard origins. Use localhost consistently
# (not 127.0.0.1) -- mixing the two here vs. NEXT_PUBLIC_API_URL is a
# classic source of "looks like CORS but isn't" confusion (Sprint 10).
CORS_ORIGINS=["http://localhost:3000"]

# --- Pacing (Sprint 9) ------------------------------------------------------
# Narrative pacing sleeps (0.5-1.5s) between pipeline beats. Production
# wants this on for the "alive" Timeline feel; tests turn it off directly
# via Settings (see conftest.py), not via this env var.
COMMANDER_PACING_ENABLED=true

# --- Mission budget guard (Sprint 9, Rule #13) ------------------------------
# Checked before each pipeline stage starts; exceeding any one of these
# blocks the mission (state -> blocked) rather than erroring.
COMMANDER_MISSION_MAX_TOKENS=200000
COMMANDER_MISSION_MAX_USD=5.0
COMMANDER_MISSION_MAX_SECONDS=900

# --- Accounts / sessions (Sprint 9, Rule #15) --------------------------------
# HttpOnly session cookie. Local dev serves http, so this stays false --
# a real deployment behind TLS must set it true or the browser drops the
# cookie silently.
COMMANDER_COOKIE_SECURE=false
# `make seed` / `make demo` create this CEO account and found "Acme AI"
# under it. Override before seeding a shared environment.
COMMANDER_DEMO_EMAIL=ceo@commander.local
COMMANDER_DEMO_PASSWORD=commander1234
