# Copy to .env and adjust. Never commit the real .env (it's gitignored).

# --- Provider -----------------------------------------------------------
# "mock" needs zero API keys and is always safe to run. "anthropic" makes
# real calls billed to your Anthropic account.
COMMANDER_PROVIDER=mock
# Only required when COMMANDER_PROVIDER=anthropic. Can also be set at
# runtime from Company Settings instead of here.
ANTHROPIC_API_KEY=

# --- Database -------------------------------------------------------------
# Default: the docker-compose Postgres service (`make db-up`). Must match
# the POSTGRES_* creds below.
DATABASE_URL=postgresql+asyncpg://commander:commander@localhost:5432/commander
# Fallback for zero-dependency local runs / CI without Docker:
# DATABASE_URL=sqlite+aiosqlite:///./commander.db

# Credentials for the docker-compose postgres service (Phase 1). Only
# used by `docker compose up postgres`; change them for anything beyond
# local dev.
POSTGRES_USER=commander
POSTGRES_PASSWORD=commander
POSTGRES_DB=commander
POSTGRES_PORT=5432

# --- Workspace / Sandbox --------------------------------------------------
# Where each company's git-backed workspace lives on disk.
COMMANDER_WORKSPACE_ROOT=./workspaces
# Docker image built by `make sandbox-image`, used to run trusted
# template CheckSpecs (Sprint 6). Only needed if you want sandboxed
# checks; the product degrades gracefully without it.
COMMANDER_SANDBOX_IMAGE=commander-sandbox

# --- Provider resilience ---------------------------------------------------
PROVIDER_TIMEOUT_SECONDS=60.0
PROVIDER_MAX_RETRIES=2

# --- CORS -------------------------------------------------------------------
# JSON array of allowed dashboard origins.
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
